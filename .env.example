# Database Configurations
MONGO_URI=mongodb://mongodb:27017
REDIS_URL=redis://redis:6379

# Security configurations
# IMPORTANT: Change JWT_SECRET in production!
JWT_SECRET=development_secret_key_change_in_production_12345
JWT_EXPIRE_MINUTES=1440
# Required only when creating organizer accounts through the public signup screen.
# Use a long, private value (minimum 12 characters) and rotate it if disclosed.
ORGANIZER_SIGNUP_CODE=replace-with-a-private-organizer-code
CHECKIN_GRACE_HOURS=12
